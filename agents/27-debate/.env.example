# Required
OPENAI_API_KEY=sk-...
LANGWATCH_API_KEY=sk-...

# Optional — defaults shown
MA_MODE=single       # single | debate | self_consistency
MODEL=gpt-4o-mini
N_AGENTS=3
DEBATE_ROUNDS=2      # revision rounds after the initial one
DEBATE_TEMP=0.7      # agents must diverge to have anything to debate
